<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

    <!-- "More controls" screen: the full Voice / Manual UI. Hidden by
         default; the simplified homePanel below is what the app opens on. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header. Two rows so the fixed-size navigation (Home, PiP,
             Settings) always fits, even at large font scales: only the
             weighted title shrinks in row 1, and the status (which can be a
             long error reason) wraps in its own row. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back to the one-button home screen. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeBackButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginEnd="4dp"
                android:text="←  Home"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Float into a Picture-in-Picture window. Hidden until connected
                 and only on devices that support PiP (toggled in code). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pipButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/content_desc_pip"
                android:visibility="gone"
                app:icon="@drawable/ic_pip_enter"
                app:iconSize="22dp"
                app:iconTint="@color/text_primary"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/content_desc_settings"
                android:text="⚙"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
        </LinearLayout>

        <!-- Setup Panel -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/header">

            <TextView
                android:id="@+id/connectionKeyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Key"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/connectionKeyInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="off"
                android:background="@drawable/input_bg"
                android:hint="Enter your connection key"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_connect"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <!-- Shown only while a connection attempt is in flight. The
                 spinner + "Connecting…" line tell the user something is
                 happening so they aren't tempted to mash Connect again
                 (the button is disabled at the same time). -->
            <LinearLayout
                android:id="@+id/connectProgressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/connectProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/accent_primary"
                    app:indicatorSize="28dp"
                    app:trackThickness="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Connecting…"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Control Panel — visible once connected. Tabbed: Voice / Manual. -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header"
            tools:visibility="visible">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabIndicatorColor="@color/accent_primary"
                app:tabSelectedTextColor="@color/accent_primary"
                app:tabTextColor="@color/text_secondary">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Voice tab content -->
            <LinearLayout
                android:id="@+id/voicePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/voiceModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap mic to listen"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/micButton"
                        android:layout_width="@dimen/mic_button_size"
                        android:layout_height="@dimen/mic_button_size"
                        android:layout_marginTop="12dp"
                        android:text="MIC"
                        android:textColor="@color/on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="48dp" />

                    <TextView
                        android:id="@+id/lastMatchText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:minHeight="24dp"
                        android:textColor="@color/status_connected"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Heard: begin (12.3)" />

                    <!-- Live audio level meter. Scales 0..1 in code so the
                         user can see at a glance whether the mic is picking
                         anything up. -->
                    <View
                        android:id="@+id/voicePeakBar"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/level_bar"
                        android:transformPivotX="0dp"
                        android:scaleX="0" />
                </LinearLayout>

                <!-- Shortcut row 1: Begin / Stop. Mirrors two of the voice
                     commands so the user can tap them when voice isn't
                     handy. The big START/STOP pair at the screen bottom is
                     still there too. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/voiceBeginButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Begin"
                        android:textColor="@color/status_connected"
                        app:strokeColor="@color/status_connected" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/voiceStopButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Stop"
                        android:textColor="@color/emergency_red"
                        app:strokeColor="@color/emergency_red" />
                </LinearLayout>

                <!-- Shortcut row 2: Slower / Faster speed nudges. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/slowerButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Slower"
                        android:textColor="@color/accent_primary"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fasterButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Faster"
                        android:textColor="@color/accent_primary"
                        app:strokeColor="@color/accent_primary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/debugToggleButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Show Debug"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/debugPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debug Log"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/debugCopyButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Copy"
                            android:textColor="@color/accent_primary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/debugClearButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Clear"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/debugScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="4dp"
                        android:background="#1A1A1A"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/debugLogText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2dp"
                            android:textColor="#AAAAAA"
                            android:textSize="11sp"
                            tools:text="[12:00:01] Engine ready" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- Manual tab content — hidden until the Manual tab is picked. -->
            <LinearLayout
                android:id="@+id/manualPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Min"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/strokeMinSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="10"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />

                    <EditText
                        android:id="@+id/strokeMinInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:autofillHints="off"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="10"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Max"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/strokeMaxSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="90"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />

                    <EditText
                        android:id="@+id/strokeMaxInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:autofillHints="off"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="90"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/speedSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent_secondary"
                        android:thumbTint="@color/accent_secondary" />

                    <EditText
                        android:id="@+id/speedInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:autofillHints="off"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/patternGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="3"
                    android:rowCount="4"
                    android:useDefaultMargins="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternPulse"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Pulse"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternRipple"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Ripple"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternSurge"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Surge"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternBreathe"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Breathe"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternThunder"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Thunder"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternTick"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Tick"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternTease"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Tease"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternEdge"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Edge"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternRush"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Rush"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternThrob"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Throb"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternBounce"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Bounce"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patternClimax"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_columnWeight="1"
                        android:text="Climax"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        app:strokeColor="@color/accent_primary" />
                </GridLayout>

                <TextView
                    android:id="@+id/manualFeedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:textColor="@color/accent_primary"
                    android:textSize="14sp"
                    tools:text="Stroke: 10-90%" />
            </LinearLayout>

            <!-- Start/Stop — shown on the Manual tab only. The Voice tab has
                 its own Begin / Stop shortcut buttons, so this big pair would
                 be redundant there. Default hidden because Voice is the
                 initially-selected tab; wireTabs() toggles it. -->
            <LinearLayout
                android:id="@+id/startStopRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="START"
                    android:textAllCaps="true"
                    android:textColor="@color/on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_connected"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textAllCaps="true"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/emergency_red"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Simplified home screen: one big button that starts / stops listening
         (it reads "Connect" while disconnected). Everything else lives on
         the "More controls" screen (mainScroll). Scrolls so More controls
         stays reachable in a short (split-screen) window; fillViewport lets
         the weighted spaces center the button when there's room. -->
    <ScrollView
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/homeStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/status_disconnected"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeListenButton"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Start\nlistening"
            android:textColor="@color/on_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="28sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:backgroundTint="@color/primary"
            app:cornerRadius="130dp" />

        <TextView
            android:id="@+id/homeHeardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:minHeight="28dp"
            android:textColor="@color/status_connected"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="✓ begin" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeMoreButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="More controls  →"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>
    </ScrollView>

    <!-- Dedicated Lovense toy page (shown instead of homePanel while the
         device type is Lovense). Layout in panel_toy.xml, logic in
         ui/ToyPanel.kt. -->
    <include layout="@layout/panel_toy" />

    <!-- Picture-in-Picture overlay. Hidden during normal full-screen use;
         swapped in by onPictureInPictureModeChanged so the tiny floating
         window shows a clean, readable status instead of the shrunk-down full
         UI. The actual controls in PiP are the system RemoteAction bar built
         in PipController, not these views (a PiP window can't take touches on
         its own content). -->
    <LinearLayout
        android:id="@+id/pipOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/pipStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="▶ 45%" />

        <TextView
            android:id="@+id/pipHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Tap to open" />
    </LinearLayout>
</FrameLayout>
