<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Palette: electric blue accent on deep cool charcoal. Status greens
        and reds stay muted so the brand accent never doubles as an alarm.
        Colour names are deliberately semantic (`accent_primary`, etc.) so
        future palette swaps only touch this file.
    -->

    <!-- Brand accents -->
    <color name="primary">#00B0FF</color>
    <color name="primary_dark">#0086C7</color>
    <color name="accent_primary">#00B0FF</color>
    <color name="accent_primary_dim">#0086C7</color>
    <color name="accent_secondary">#5C8DFF</color>
    <color name="accent_secondary_dim">#3D5AFE</color>

    <!-- Text colour to lay on top of accent_primary (bright) buttons. -->
    <color name="on_primary">#001830</color>

    <!-- Surfaces: deep navy charcoal. -->
    <color name="background_dark">#080C16</color>
    <color name="surface_dark">#131826</color>
    <color name="card_dark">#1C2235</color>

    <!-- Text -->
    <color name="text_primary">#EAF2FF</color>
    <color name="text_secondary">#8B97AE</color>

    <!-- Status (muted, not neon) -->
    <color name="status_connected">#7FB390</color>
    <color name="status_disconnected">#C77573</color>
    <color name="status_listening">#00B0FF</color>

    <!-- Action -->
    <color name="emergency_red">#C75450</color>

    <!-- Record button states (training screen) -->
    <color name="record_idle">#00B0FF</color>
    <color name="record_active">#3D5AFE</color>
    <color name="record_done">#7FB390</color>
</resources>
