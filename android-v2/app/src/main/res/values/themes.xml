<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HandyVoiceV2" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Splash: same dark theme, but the window background is the splash
         colour so there's no white/grey flash between the system window
         appearing and the splash layout drawing. -->
    <style name="Theme.HandyVoiceV2.Splash" parent="Theme.HandyVoiceV2">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Card section header on the Settings screen: small, bold, accent,
         letter-spaced caps so each group reads as a distinct section. -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
