# AI/LLM scratch space
_scratch/
_draft_*
*.tmp
.cascade/
.cursor/
.claude/

# Dependencies
node_modules/
package-lock.json

# Environment variables
.env
.env.local

# OS files
.DS_Store
Thumbs.db
*.stackdump

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Built APK installers (binaries); keep the folder via apks/README.md
/apks/*.apk

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vendor CAD and datasheets (downloaded, not ours to redistribute); hardware/cad/README.md lists the sources
/hardware/cad/**
!/hardware/cad/README.md

# nl-cad build outputs (regenerated by nlcad.build, same rule as nl-cad)
/hardware/*/builds/*/*.glb
/hardware/*/builds/*/*.step
/hardware/*/builds/*/renders/*.png
/hardware/*/builds/*/*_viewer_v*.html
__pycache__/

# Jazzer fuzzing scratch: the working corpus, and raw findings dropped in the
# module directory when Jazzer cannot find the seed corpus. Anchored to the
# module directory on purpose: a reproducer Jazzer writes next to the seed corpus
# (android-v2/app/src/test/resources/**/*FuzzTestInputs/<method>/crash-<hash>)
# must stay visible, because it gets committed as a regression test.
/android-v2/app/.cifuzz-corpus/
/android-v2/app/crash-*
/android-v2/app/timeout-*
/android-v2/app/slow-unit-*
/android-v2/app/oom-*
