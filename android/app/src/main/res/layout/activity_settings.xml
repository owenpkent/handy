<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout 
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- API Key Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/apiKeyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="@string/api_key_label"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textSize="18sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Connection Key Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/connectionKeyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/connection_key_label"
        app:layout_constraintTop_toBottomOf="@id/apiKeyLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/connectionKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="18sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:text="@string/save"
        android:textSize="20sp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/connectionKeyLayout" />

    <!-- Voice Engine Section -->
    <TextView
        android:id="@+id/voiceEngineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Voice Engine"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saveButton" />

    <RadioGroup
        android:id="@+id/voiceEngineGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/voiceEngineTitle">

        <RadioButton
            android:id="@+id/radioVosk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Vosk Offline (constrained, recommended)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:buttonTint="@color/primary"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioAndroidStt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Android Speech (local, unconstrained)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:buttonTint="@color/primary" />

        <RadioButton
            android:id="@+id/radioDeepgram"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Deepgram AI (cloud, best accuracy)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:buttonTint="@color/primary" />
    </RadioGroup>

    <!-- Deepgram API Key -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/deepgramKeyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Deepgram API Key"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/voiceEngineGroup"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/deepgramKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textSize="18sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Voice Settings Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveVoiceButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Save Voice Settings"
        android:textSize="18sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/deepgramKeyLayout" />

    <!-- Voice Commands Reference -->
    <TextView
        android:id="@+id/commandsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/voice_commands_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saveVoiceButton" />

    <TextView
        android:id="@+id/commandsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="8dp"
        android:text="• Start / Go\n• Stop\n• Faster / Speed up\n• Slower / Slow down\n• Speed [number]\n• Slow/Med/Fast + Top/Mid/Bot/Full\n• Maximum [number]\n• Minimum [number]"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/commandsTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
