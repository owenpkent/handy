<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SmartDong"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            
            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />
            
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
            
            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Setup Panel -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/header">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Key"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
            
            <EditText
                android:id="@+id/connectionKeyInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_bg"
                android:hint="Enter your connection key"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Connect"
                android:textSize="18sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Control Panel -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header">

            <!-- Sliders Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Min Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="Min"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    
                    <SeekBar
                        android:id="@+id/strokeMinSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="10"
                        android:progressTint="@color/slider_orange"
                        android:thumbTint="@color/slider_orange" />
                    
                    <EditText
                        android:id="@+id/strokeMinInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="10"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Max Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="Max"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    
                    <SeekBar
                        android:id="@+id/strokeMaxSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="90"
                        android:progressTint="@color/slider_orange"
                        android:thumbTint="@color/slider_orange" />
                    
                    <EditText
                        android:id="@+id/strokeMaxInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="90"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Speed Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    
                    <SeekBar
                        android:id="@+id/speedSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/slider_blue"
                        android:thumbTint="@color/slider_blue" />
                    
                    <EditText
                        android:id="@+id/speedInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="100"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Global Min Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="G.Min"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    
                    <SeekBar
                        android:id="@+id/globalMinSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/slider_red"
                        android:thumbTint="@color/slider_red" />
                    
                    <EditText
                        android:id="@+id/globalMinInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Global Max Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="G.Max"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    
                    <SeekBar
                        android:id="@+id/globalMaxSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/slider_red"
                        android:thumbTint="@color/slider_red" />
                    
                    <EditText
                        android:id="@+id/globalMaxInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="100"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Speed Limit Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="Spd.Lim"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/speedLimitSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="1"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/slider_red"
                        android:thumbTint="@color/slider_red" />

                    <EditText
                        android:id="@+id/speedLimitInput"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="100"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Preset Grid -->
            <GridLayout
                android:id="@+id/presetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="3"
                android:rowCount="4"
                android:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetSlowTop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Slow Top"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetMedTop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Med Top"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetFastTop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Fast Top"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetSlowMid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Slow Mid"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetMedMid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Med Mid"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetFastMid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Fast Mid"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetSlowBot"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Slow Bot"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetMedBot"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Med Bot"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetFastBot"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Fast Bot"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetSlowFull"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Slow Full"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetMedFull"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Med Full"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetFastFull"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Fast Full"
                    android:textColor="@color/slider_orange"
                    android:textSize="12sp"
                    app:strokeColor="@color/slider_orange" />
            </GridLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="START"
                    android:textAllCaps="true"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_connected"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textAllCaps="true"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/emergency_red"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Voice Control Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Voice Engine Label -->
                <TextView
                    android:id="@+id/voiceEngineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice: Android STT"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <!-- Mic Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/micButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="@dimen/mic_button_size"
                    android:layout_height="@dimen/mic_button_size"
                    android:contentDescription="@string/content_desc_mic"
                    android:text="MIC"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="48dp"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="2dp" />

                <!-- Partial Transcript (interim results) -->
                <TextView
                    android:id="@+id/partialTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:minHeight="20dp"
                    tools:text="listening..." />

                <!-- Last Command -->
                <TextView
                    android:id="@+id/lastCommandText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/status_connected"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:minHeight="24dp"
                    tools:text="Command: Start" />
            </LinearLayout>

            <!-- Feedback -->
            <TextView
                android:id="@+id/feedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/status_connected"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Speed set to 50%"
                tools:visibility="visible" />

            <!-- Debug Panel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/debugToggleButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Show Debug"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/debugPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Debug Log"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/debugCopyButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textColor="@color/slider_orange"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/debugClearButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Clear"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/debugScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="4dp"
                    android:background="#1A1A1A"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/debugLogText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        tools:text="[12:00:01] Vosk: initialized\n[12:00:02] Vosk: listening...\n[12:00:05] partial: slow\n[12:00:06] result: slow top" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
